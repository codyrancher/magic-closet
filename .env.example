# Copy to .env and adjust. Every value here is optional — sensible defaults
# are baked into the compose files.

# Which sidecars start with `docker compose up -d`. Comma-separated list of
# profile names (= sidecar directory names). Remove one to make `up` skip it;
# it can still be started later via the API or `mc start <name>`.
COMPOSE_PROFILES=vscode,rancher-browser,rancher,keycloak

# ---- Port forwarding -------------------------------------------------------
# Only API_PORT is needed — every other host port is derived from it (below).
# Keep API_PORT within ~8300-8339 so the derived ports stay in the wrapper's
# published 8300-8399 range. To override any single port, add its line here
# (e.g. VSCODE_PORT=9000); the derivation leaves explicitly-set ports alone.
API_PORT=8300          # sidecar control API (http)
# Derived from API_PORT (offset): API_HTTPS +1, DEV +5, VSCODE +10,
# RANCHER_BROWSER +20, KEYCLOAK +30, OPENLDAP +40, RANCHER +44, FIGMA +60

# The host's external IP/hostname, used for Rancher's server-url so clusters
# provisioned inside a closet can reach it from outside. Unset -> https://rancher
# (in-network only). e.g. MC_PUBLIC_HOST=136.63.17.126
MC_PUBLIC_HOST=

# ---- User mapping ----------------------------------------------------------
PUID=1000
PGID=1000

# ---- Sidecar parameters ----------------------------------------------------
# Also settable per-start through the API: POST /sidecars/<name>/start
RANCHER_TAG=head
FIGMA_API_KEY=
RANCHER_AUTH_PROVIDER=keycloak
# NODE_VERSION is auto-filled by the api from rancher/dashboard:master
NODE_VERSION=
GH_TOKEN=
APPCO_EMAIL=
APPCO_TOKEN=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_DEFAULT_REGION=us-west-2

# ---- Generated secrets -----------------------------------------------------
# Leave empty — filled automatically by setup.sh (or by the api on boot).
RANCHER_BOOTSTRAP_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
OPENLDAP_ADMIN_PASSWORD=
RANCHER_PRIME=
# Repo/PR/issue cloned into /workspace/dashboard. Empty = rancher/dashboard
# master; set to a PR (…/pull/123) or issue (…/issues/456) URL to override.
GITHUB_URL=
